{
  "name": "@nakedev/nextjs-fsd",
  "version": "0.1.1",
  "description": "Keep a Next.js App Router project on Feature-Sliced Design: init the layout, generate slices, add auth and API error handling",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NakePranob/nextjs-fsd.git"
  },
  "bin": {
    "nextjs-fsd": "bin/nextjs-fsd.js"
  },
  "files": [
    "dist",
    "templates",
    "bin",
    "LICENSE"
  ],
  "type": "commonjs",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "node --test tests/*.test.mjs && node scripts/smoke-test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:integration": "node scripts/integration-test.mjs",
    "verify": "pnpm run build && pnpm run test",
    "release:check": "node scripts/check-release.mjs",
    "prepack": "rm -rf dist && pnpm run build",
    "prepublishOnly": "pnpm run release:check && pnpm run verify"
  },
  "keywords": [
    "nextjs",
    "feature-sliced",
    "fsd",
    "scaffold",
    "cli",
    "generator"
  ],
  "author": "nakedev",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.1",
    "commander": "^15.0.0",
    "fs-extra": "^11.3.0",
    "handlebars": "^4.7.8",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@types/bun": "^1.3.14",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axios": "^1.19.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
